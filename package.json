{
  "name": "headless-web",
  "version": "2.0.0",
  "description": "Advanced web-based headless browsing gateway with multiple compatibility modes including Live Mode, Snapshots, and PDF generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "proxy",
    "headless",
    "browser",
    "gateway",
    "playwright",
    "websocket",
    "snapshot",
    "pdf-generation",
    "redis",
    "cookie-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "express": "^4.18.2",
    "ioredis": "^5.9.1",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
