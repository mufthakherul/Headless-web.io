# Server Configuration
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=headless_web
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Authentication
# Admin account that works even when database is down
ADMIN_EMAIL=admin@headless-web.io
ADMIN_PASSWORD=change_this_secure_password
JWT_SECRET=your_64_character_random_hex_string_here_replace_with_crypto_random_bytes
JWT_EXPIRES_IN=7d

# AI Provider API Keys (at least one required for AI chat)
# Get your API keys from respective platforms:
Google AI Studio: https://aistudio.google.com/
OpenAI: https://platform.openai.com/
xAI (Grok): https://x.ai/
DeepSeek: https://platform.deepseek.com/
GitHub Copilot: https://github.com/settings/copilot

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
COPILOT_API_KEY=your_github_copilot_api_key_here

# Redis (optional, for distributed sessions)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# CORS (optional)
CORS_ORIGIN=*

# YouTube Downloader (optional)
# Set to true to prevent ytdl-core from automatically updating
YTDL_NO_UPDATE=true
# Default video quality (highest, high, medium, low)
VIDEO_QUALITY_DEFAULT=high
# Download timeout in milliseconds
DOWNLOAD_TIMEOUT=300000
# Maximum file size in MB
MAX_DOWNLOAD_SIZE=500

# Web Scraper (optional)
# Scraping timeout in milliseconds
SCRAPER_TIMEOUT=30000
# Enable social media scraping
ENABLE_SOCIAL_MEDIA_SCRAPING=true
# Maximum pages to scrape
MAX_SCRAPE_PAGES=1

# Session Management (optional)
# Session timeout in minutes
SESSION_TIMEOUT=1440
# Session encryption key
SESSION_SECRET=your_session_secret_here

# Logging (optional)
# Log level: error, warn, info, debug
LOG_LEVEL=info

# API Rate Limiting (optional)
# Rate limit window in minutes
RATE_LIMIT_WINDOW=1
# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=60

# File Management (optional)
# Delete download history older than X days (0 = never delete)
DOWNLOAD_RETENTION_DAYS=30
# Maximum chat history records per user
MAX_CHAT_HISTORY=1000

# Playwright (optional, disable in serverless environments)
DISABLE_PLAYWRIGHT=false
DISABLE_WEBSOCKET=false
